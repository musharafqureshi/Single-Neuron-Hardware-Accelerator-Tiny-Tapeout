set circuit1 [readnet spice /foss/designs/neuro/runs/RUN_2026-08-29_16-48-03/68-magic-spiceextraction/tt_um_neuron.spice]
set circuit2 [readnet verilog /dev/null]
puts "Reading SPICE netlist file '/foss/pdks/ihp-sg13g2/libs.ref/sg13g2_stdcell/spice/sg13g2_stdcell.spice'..."
readnet spice /foss/pdks/ihp-sg13g2/libs.ref/sg13g2_stdcell/spice/sg13g2_stdcell.spice $circuit2
puts "Reading SPICE netlist file '/foss/pdks/ihp-sg13g2/libs.ref/sg13g2_io/spice/sg13g2_io.spice'..."
readnet spice /foss/pdks/ihp-sg13g2/libs.ref/sg13g2_io/spice/sg13g2_io.spice $circuit2
puts "Reading Verilog netlist file '/foss/designs/neuro/runs/RUN_2026-08-29_16-48-03/52-openroad-fillinsertion/tt_um_neuron.pnl.v'..."
readnet verilog /foss/designs/neuro/runs/RUN_2026-08-29_16-48-03/52-openroad-fillinsertion/tt_um_neuron.pnl.v $circuit2
lvs "$circuit1 tt_um_neuron" "$circuit2 tt_um_neuron" /usr/local/lib/python3.12/dist-packages/librelane/scripts/netgen/setup.tcl /foss/designs/neuro/runs/RUN_2026-08-29_16-48-03/70-netgen-lvs/reports/lvs.netgen.rpt -blackbox -json
